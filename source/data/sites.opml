        <outline type="link" text="Vricko" title="Vricko" url="https://app.vricko.app" htmlUrl="https://app.vricko.app" description="面向小企业的 AI 代理平台，一句话即可建站、撰写内容、发邮件与客服支持，每项任务留痕并设月度支出上限。" />
        <outline type="link" text="Turbofy" title="Turbofy" url="https://turbofy.com" htmlUrl="https://turbofy.com" description="对话式 AI 应用构建平台，用自然语言生成带数据、认证与托管的生产级业务应用，并支持 MCP 连接外部编码智能体。" />
        <outline type="link" text="RigSpark" title="RigSpark" url="https://rigspark.si" htmlUrl="https://rigspark.si" description="开源本地 AI 选型工具，检测电脑内存与显卡后自动挑选可运行的大模型、图像、视频或语音模型并下载运行。" />
        <outline type="link" text="YouArt" title="YouArt" url="https://youart.ai" htmlUrl="https://youart.ai" description="对话式 AI 创意平台，用智能体把需求拆成分镜与配音并在画布生成图像视频，支持多模型聚合与桌面版。" />
        <outline type="link" text="云策 Omni" title="云策 Omni" url="https://www.yuncehub.com" htmlUrl="https://www.yuncehub.com" description="跨平台本地 AI 工作台，用模型加技能加插件组合让智能体完成开发、创作与自动化任务，数据存于本机。" />
        <outline type="link" text="Clipwright" title="Clipwright" url="https://clipwright.io" htmlUrl="https://clipwright.io" description="面向AI智能体的视频制作后端，通过MCP或API拆解热门短视频并生成带口播的广告MP4，渲染前先报价。" />
        <outline type="link" text="Cognee" title="Cognee" url="https://www.cognee.ai" htmlUrl="https://www.cognee.ai" description="开源 AI 智能体记忆平台，用知识图谱与向量检索为大模型应用构建跨会话持久记忆，支持自托管与云服务。" />
        <outline type="link" text="magpie" title="magpie" url="https://usemagpie.ai" htmlUrl="https://usemagpie.ai" description="本地 AI 模型网关，统一接入 DeepSeek、Claude、Kimi 等模型订阅，供各类编码智能体按需切换。" />
        <outline type="link" text="webAI" title="webAI" url="https://www.webai.com" htmlUrl="https://www.webai.com" description="在 Mac 本地运行小模型的 AI 应用，可搭建多个 AI 专家（Persona）协作处理私有文档，数据不上云、不计 token 费。" />
        <outline type="link" text="DomoAI" title="DomoAI" url="https://domoai.app" htmlUrl="https://domoai.app" description="在线 AI 视频与动画创作平台，支持用文字、图片或视频素材完成生成、风格化与画质提升。" />
        <outline type="link" text="Ollama" title="Ollama" url="https://ollama.com" htmlUrl="https://ollama.com" description="在本地或云端运行开源大模型的工具，支持 macOS、Windows、Linux，一条命令即可启动模型。" />
      </outline>
      <outline text="模型框架" title="模型框架">
        <outline type="link" text="microsoft/VibeVoice" title="microsoft/VibeVoice" url="https://github.com/microsoft/VibeVoice" htmlUrl="https://github.com/microsoft/VibeVoice" description="微软开源的前沿语音 AI 模型，面向高质量语音生成与实时语音交互场景。" />
        <outline type="link" text="Interactive-Active-AI/NextTransformer" title="Interactive-Active-AI/NextTransformer" url="https://github.com/Interactive-Active-AI/NextTransformer" htmlUrl="https://github.com/Interactive-Active-AI/NextTransformer" description="面向下一代 Transformer 与大模型的开源框架，提供算力对齐基准与架构自主研究能力。" />
        <outline type="link" text="algorithmicsuperintelligence/optillm" title="algorithmicsuperintelligence/optillm" url="https://github.com/algorithmicsuperintelligence/optillm" htmlUrl="https://github.com/algorithmicsuperintelligence/optillm" description="LLM 推理优化代理，通过多种提示与缓存策略降低大模型调用成本并提升响应效率。" />
        <outline type="link" text="cactus-compute/cactus" title="cactus-compute/cactus" url="https://github.com/cactus-compute/cactus" htmlUrl="https://github.com/cactus-compute/cactus" description="面向消费级设备的轻量端侧推理库，体积不足 50MB，本地运行智能体、语音与视觉任务，无需云端。" />
        <outline type="link" text="higurashi-ai/Haru" title="higurashi-ai/Haru" url="https://github.com/higurashi-ai/Haru" htmlUrl="https://github.com/higurashi-ai/Haru" description="低延迟多语言全双工语音对话模型，可边听边说，以 133 毫秒分块连续生成口语回应。" />
        <outline type="link" text="huawei-csl/MACaQ" title="huawei-csl/MACaQ" url="https://github.com/huawei-csl/MACaQ" htmlUrl="https://github.com/huawei-csl/MACaQ" description="华为开源的模型无关量化工具，面向 GGUF 与本地推理，可量化并运行文本、图像、视频与音频模型。" />
        <outline type="link" text="mw00/project-maya" title="mw00/project-maya" url="https://github.com/mw00/project-maya" htmlUrl="https://github.com/mw00/project-maya" description="开源本地大模型推理引擎，通过 GPU、内存与固态盘三级分层调度权重，让数百 B 模型跑在消费级硬件，兼容 OpenAI/Anthropic API。" />
        <outline type="link" text="Edge0-AI/Edge0" title="Edge0-AI/Edge0" url="https://github.com/Edge0-AI/Edge0" htmlUrl="https://github.com/Edge0-AI/Edge0" description="端侧基础模型与流式 MoE 推理框架，通过 SSD 流式权重与专家路由，让 145B 模型跑在笔记本、35B 跑在手机上。" />
        <outline type="link" text="jundot/omlx" title="jundot/omlx" url="https://github.com/jundot/omlx" htmlUrl="https://github.com/jundot/omlx" description="面向苹果芯片的大模型推理服务器，支持连续批处理与 SSD 分层缓存，可从菜单栏管理。" />
        <outline type="link" text="raullenchai/Rapid-MLX" title="raullenchai/Rapid-MLX" url="https://github.com/raullenchai/Rapid-MLX" htmlUrl="https://github.com/raullenchai/Rapid-MLX" description="基于 MLX 的苹果芯片推理服务器，兼容 OpenAI 与 Anthropic 接口，专注编码智能体工具调用。" />
        <outline type="link" text="skyzh/tiny-llm" title="skyzh/tiny-llm" url="https://github.com/skyzh/tiny-llm" htmlUrl="https://github.com/skyzh/tiny-llm" description="面向系统工程师的 Apple Silicon LLM 推理教学项目，用 Python 从零搭建迷你 vLLM 并运行 Qwen 模型。" />
        <outline type="link" text="jingyaogong/minimind" title="jingyaogong/minimind" url="https://github.com/jingyaogong/minimind" htmlUrl="https://github.com/jingyaogong/minimind" description="仅需 2 小时即可从零训练 6400 万参数小语言模型的开源项目，适合快速上手大模型训练全流程。" />
        <outline type="link" text="flashml-org/FreeToken" title="flashml-org/FreeToken" url="https://github.com/flashml-org/FreeToken" htmlUrl="https://github.com/flashml-org/FreeToken" description="把数据中心级模型服务带到桌面的开源引擎，可在个人电脑上本地运行超大规模语言模型。" />
        <outline type="link" text="FareedKhan-dev/kimi-k3-in-c" title="FareedKhan-dev/kimi-k3-in-c" url="https://github.com/FareedKhan-dev/kimi-k3-in-c" htmlUrl="https://github.com/FareedKhan-dev/kimi-k3-in-c" description="用纯C99实现的推理引擎，可在单核CPU、8GB内存中运行2.78万亿参数的Kimi K3大模型，零依赖。" />
        <outline type="link" text="nv-tlabs/lyra" title="nv-tlabs/lyra" url="https://github.com/nv-tlabs/Lyra" htmlUrl="https://github.com/nv-tlabs/Lyra" description="英伟达开源的生成式 3D 世界模型项目，可从输入图像生成可探索的三维场景，开放代码与预训练权重。" />
      </outline>
    </outline>
